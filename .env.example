# Copy to .env and fill in. .env is gitignored and never committed.
# The API key is read from the environment only -- flaketriage.toml must never contain it.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the models chosen in flaketriage.toml (useful in CI).
# FLAKETRIAGE_CLASSIFIER_MODEL=claude-sonnet-5
# FLAKETRIAGE_PREFILTER_MODEL=claude-haiku-4-5-20251001
